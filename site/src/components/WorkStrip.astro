---
// Full-width work row in the same frosted-glass style as HomeCaseTile.
interface Props {
  label: string;      // e.g. "工程 · 2026"
  title: string;
  summary: string;
  stats?: string[];
  cta: string;
  href: string;
  accent?: string;
  revealDelay?: number;
}

const { label, title, summary, stats = [], cta, href, accent = 'rgba(255,255,255,0.4)', revealDelay = 0 } = Astro.props;
const external = href.startsWith('http');
---

<a
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
  class="work-strip reveal group relative grid grid-cols-12 gap-x-6 gap-y-3 items-center rounded-[16px] border border-white/10
         px-6 py-6 md:px-8 md:py-7 overflow-hidden
         transition-[border-color,background-color] duration-[600ms] hover:border-white/20"
  style={`--reveal-delay: ${revealDelay}ms; --strip-accent: ${accent}`}
  data-reveal
>
  <span class="strip-accent-bar absolute top-0 left-0 right-0 h-px pointer-events-none"></span>

  <div class="col-span-12 md:col-span-4">
    <div class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/55">{label}</div>
    <h3 class="font-sans font-bold text-[26px] md:text-[30px] leading-[1.1] text-white mt-2 tracking-[-0.02em]">{title}</h3>
  </div>

  <p class="col-span-12 md:col-span-5 font-sans text-[13.5px] leading-[1.65] text-white/65">{summary}</p>

  <div class="col-span-12 md:col-span-3 flex md:flex-col md:items-end justify-between gap-3">
    {stats.length > 0 && (
      <ul class="flex flex-wrap md:justify-end gap-x-3 gap-y-1 font-mono text-[10.5px] uppercase tracking-[0.16em] text-white/55">
        {stats.map((s) => <li class="strip-stat">{s}</li>)}
      </ul>
    )}
    <span class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.22em] text-white/65 group-hover:text-white transition-colors duration-500">
      {cta}
      <span class="inline-block transition-transform duration-500 group-hover:translate-x-0.5 group-hover:-rotate-[35deg]">→</span>
    </span>
  </div>
</a>

<style>
  .work-strip {
    isolation: isolate;
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(40px) saturate(0.8) brightness(0.7);
    -webkit-backdrop-filter: blur(40px) saturate(0.8) brightness(0.7);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      inset 0 0 40px rgba(0, 0, 0, 0.15),
      0 4px 30px rgba(0, 0, 0, 0.25);
  }
  .work-strip:hover { background: rgba(255, 255, 255, 0.065); }
  .strip-accent-bar {
    background: linear-gradient(to right, var(--strip-accent), transparent 70%);
    opacity: 0.45;
    transition: opacity 0.5s;
  }
  .work-strip:hover .strip-accent-bar { opacity: 1; }
  .strip-stat + .strip-stat::before { content: '·'; margin-right: 0.75rem; color: rgba(255, 255, 255, 0.3); }
</style>
