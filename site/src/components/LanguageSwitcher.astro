---
const { class: className } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL; // e.g. /jielle/

// Basic path manipulation to switch between EN and ZH routes
// If current path starts with /jielle/zh/, EN path removes zh/.
// If current path is /jielle/something, ZH path inserts zh/ after base.

let enPath = currentPath;
let zhPath = currentPath;

if (currentPath.startsWith(`${base}zh/`)) {
  enPath = currentPath.replace(`${base}zh/`, base);
} else {
  zhPath = currentPath.replace(base, `${base}zh/`);
  // If it's the exact base URL without trailing slash
  if (currentPath === base.replace(/\/$/, '')) {
      zhPath = `${base}zh/`;
  }
}
---

<div class:list={["flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.2em]", className]}>
  <a 
    href={enPath} 
    class:list={[
      "transition-colors duration-300", 
      currentPath === enPath ? "text-white font-bold" : "text-white/40 hover:text-white/70"
    ]}>
    EN
  </a>
  <span class="text-white/20">|</span>
  <a 
    href={zhPath} 
    class:list={[
      "transition-colors duration-300", 
      currentPath === zhPath ? "text-white font-bold" : "text-white/40 hover:text-white/70"
    ]}>
    中文
  </a>
</div>
