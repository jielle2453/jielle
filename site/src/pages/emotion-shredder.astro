---
import BaseCaseStudy from '../layouts/BaseCaseStudy.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

const base = import.meta.env.BASE_URL;

const roleItems = [
  {
    title: 'Research & Concept',
    body: 'Translated psychological research into product mechanics.',
  },
  {
    title: 'UI/UX Design',
    body: 'Designed 10 core screens and the 12-flower visual system.',
  },
  {
    title: 'Development',
    body: 'Built the prototype using React, Supabase, and Gemini API.',
  },
];

const designDecisions = [
  {
    no: '01',
    title: 'Flower meanings, not mood scores',
    body: 'The AI matches input to a specific flower based on meaning — open and free from judgment, avoiding good/bad performance metrics.',
  },
  {
    no: '02',
    title: 'Free input first, AI names it after',
    body: "When emotions are messy, users can't always name them. The AI steps in only after the shredding ritual.",
  },
  {
    no: '03',
    title: "Today's entry shows only a sprout",
    body: "Separates the venting moment from reflection. The flower blooms the next day so users don't stare at raw emotions.",
  },
  {
    no: '04',
    title: 'Raw text is never saved',
    body: 'Input is only used momentarily for AI analysis. Once shredded, it is permanently destroyed.',
  },
];

const screens = [
  {
    id: 'login',
    no: '3.1',
    title: 'Login',
    desc: 'Three entry paths ranked by friction: email, one-tap Google, or guest mode at the very bottom — lowest commitment, never hidden. The soft wordmark and illustrated flowers set the emotional register before any interaction.',
    media: `${base}img/es_login.jpg`,
    mediaType: 'img' as const,
    alt: 'Login screen',
  },
  {
    id: 'shredder',
    no: '3.2',
    title: 'Shredder (Home)',
    desc: "The only required interaction. Write anything into the torn paper, press the shredder button — no character limit, no tags, no confirmation dialog. The text disappears and that disappearance is the ritual. The bottom tab bar stays visible throughout so navigation never competes with venting.",
    media: `${base}img/es_shredder_animation.mp4`,
    mediaType: 'video' as const,
    alt: 'Shredder animation',
  },
  {
    id: 'calendar',
    no: '3.3',
    title: 'Calendar',
    desc: "Each day with a completed entry shows a flower instead of a number. A month reads as a field of blooms — emotional history at a glance, no score attached. A gift icon in the corner unlocks once the month is complete.",
    media: `${base}img/es_calendar.jpg`,
    mediaType: 'img' as const,
    alt: 'Calendar view',
  },
  {
    id: 'daily',
    no: '3.4',
    title: 'Daily record',
    desc: "One tap from the calendar. Shows the flower name and its meaning, keyword scraps from the AI, a short reframing reflection in a handwritten-style font — and an open note field for hindsight writing. Left/right arrows let the user page through days without returning to the calendar.",
    media: `${base}img/es_daily_record.jpg`,
    mediaType: 'img' as const,
    alt: 'Daily record view',
  },
  {
    id: 'bouquet',
    no: '3.5',
    title: 'Monthly bouquet',
    desc: "On the 1st of each month, every flower earned that month is gathered into a single illustrated bouquet with a handwritten note. The product's one moment of ceremony — downloadable and shareable, and the app's only built-in growth loop.",
    media: `${base}img/es_monthly_bouquet.jpg`,
    mediaType: 'img' as const,
    alt: 'Monthly bouquet reveal',
  },
  {
    id: 'garden',
    no: '3.6',
    title: 'Garden',
    desc: "Every unlocked flower planted on a rolling hillside. Tap a flower to make it sway; tap the background to cycle a weather layer. No list, no timestamps, no counts — built to be looked at, not read.",
    media: `${base}img/es_garden_interaction.mp4`,
    mediaType: 'video' as const,
    alt: 'Garden interaction',
  },
  {
    id: 'collection',
    no: '3.7',
    title: 'Collection',
    desc: "A grid of all 12 flowers. Unlocked ones appear in full color; locked ones render as grayscale silhouettes. A light collectible mechanic — the only way to unlock a flower is to go through the shredding ritual on a day that produces that emotional tone.",
    media: `${base}img/es_collection.jpg`,
    mediaType: 'img' as const,
    alt: 'Flower collection grid',
  },
  {
    id: 'flower-detail',
    no: '3.8',
    title: 'Flower detail',
    desc: 'Large illustration, a badge showing how many times earned, and a short paragraph on what the flower represents — written to validate rather than label. Writing all 12 meanings was as much a content-design task as a UI one.',
    media: `${base}img/es_flower_detail.jpg`,
    mediaType: 'img' as const,
    alt: 'Flower detail card',
  },
  {
    id: 'settings',
    no: '3.9',
    title: 'Settings',
    desc: '"Privacy / AI use" and "Delete all records" sit at the same visual level as the sign-out button. For a product asking people to write things they might not want kept, the ability to fully undo that trust must be easy to find.',
    media: `${base}img/es_settings.jpg`,
    mediaType: 'img' as const,
    alt: 'Settings screen',
  },
];
---

<BaseCaseStudy title="Emotion Shredder — Jielle Lu">
  <main class="relative z-10 mx-auto max-w-[1200px] min-h-screen px-6 md:px-12 lg:px-16 pt-8 md:pt-10 pb-24">

    <!-- TOP CHROME -->
    <header class="flex items-start justify-between gap-6 font-mono text-[10.5px] uppercase tracking-[0.2em]">
      <a href={base} class="inline-flex items-center gap-1.5 text-white/70 hover:text-white transition-colors">
        <span>←</span> Home
      </a>
      <div class="text-right space-y-0.5 text-white/55">
        <div class="text-white/80">03-Emotion Shredder</div>
        <div>Portfolio of Jielle Lu</div>
        <LanguageSwitcher class="mt-4 justify-end" />
      </div>
    </header>

    <!-- HERO -->
    <section class="mt-16 md:mt-24 grid grid-cols-12 gap-6 md:gap-10">
      <div class="col-span-12 md:col-span-8">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white/55 mb-4 flex items-center gap-2">
          <span class="text-white text-base leading-none">◆</span>
          <span>Chapter Three — Emotion Shredder APP</span>
        </div>

        <h1 class="font-sans font-black tracking-[-0.055em] leading-[0.88] text-white text-[clamp(56px,10vw,160px)]">
          <span class="block">Emotion</span>
          <span
            class="block font-light italic text-white/60 tracking-[-0.025em]"
            style="font-family: 'Fraunces', serif; font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;"
          >
            Shredder.
          </span>
        </h1>

        <p class="mt-10 max-w-[52ch] text-[17px] leading-[1.55] text-white/80">
          A mobile ritual for emotional release —
          <span class="italic text-white" style="font-family:'Fraunces',serif">type it out, shred it, and watch it grow into a flower.</span>
        </p>
      </div>

      <aside class="col-span-12 md:col-span-4 md:pt-16 flex justify-start md:justify-center">
        <div class="flex flex-col items-center md:-ml-8">
          <figure class="rounded-[12px] overflow-hidden border border-white/10 w-full max-w-[240px] mb-5 mt-8 md:mt-0">
            <img src={`${base}img/es_cover.png`} alt="Emotion Shredder preview" class="w-full h-auto block" />
          </figure>
          <a
            href="https://jielle2453.github.io/emotion-shredder-demo/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-mono text-[10.5px] uppercase tracking-[0.2em] text-[#FBBFCA] hover:text-white transition-colors"
          >
            <span>↗</span>
            <span>Live demo</span>
          </a>
        </div>
      </aside>
    </section>

    <!-- PROJECT META + MY ROLE -->
    <section class="mt-20 md:mt-28 grid grid-cols-12 gap-10">
      <div class="col-span-12 md:col-span-4">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-b border-white/15 pb-3 mb-5">
          <span class="text-white/80"></span> Project meta
        </div>
        <dl class="space-y-3 text-[14.5px] leading-[1.55] text-white/75">
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">Time</dt><dd>2026.05 — present</dd></div>
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">Type</dt><dd>Solo project</dd></div>
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">Tools</dt><dd>Figma · React · Vite · Supabase · Gemini API</dd></div>
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">Tags</dt><dd class="text-white/55">Web App · Mental Health · GenAI</dd></div>
        </dl>
      </div>

      <div class="col-span-12 md:col-span-8">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-b border-white/15 pb-3 mb-5">
          <span class="text-white/80"></span> My role
        </div>
        <ul class="space-y-4">
          {roleItems.map((r) => (
            <li class="grid grid-cols-[160px_1fr] gap-4">
              <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-white/80 pt-[2px]">{r.title}</span>
              <span class="text-[14.5px] leading-[1.6] text-white/70">{r.body}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 1 THE PROBLEM -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">01</span> — The problem
      </div>
      <h2 class="text-white leading-[0.95] max-w-[24ch]" style="font-family:'Fraunces',serif;font-size:clamp(32px,5vw,56px);letter-spacing:-0.03em">
        Every existing tool<br />
        <span class="italic text-white/60"> faces the same three pain points.</span>
      </h2>

      <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-5">
        <article class="rounded-[14px] border border-white/12 bg-white/[0.04] backdrop-blur-md p-6 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.6),inset_0_1px_0_0_rgba(255,255,255,0.06)]">
          <div class="text-white leading-none text-[44px] mb-4" style="font-family:'Fraunces',serif;letter-spacing:-0.03em">01</div>
          <h3 class="font-sans font-semibold text-[17px] text-white mb-2">High input cost</h3>
          <p class="text-[14px] leading-[1.6] text-white/65">Naming an emotion, writing at length. When you're mid-anxiety, the bar is already too high.</p>
        </article>
        <article class="rounded-[14px] border border-white/12 bg-white/[0.04] backdrop-blur-md p-6 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.6),inset_0_1px_0_0_rgba(255,255,255,0.06)]">
          <div class="text-white leading-none text-[44px] mb-4" style="font-family:'Fraunces',serif;letter-spacing:-0.03em">02</div>
          <h3 class="font-sans font-semibold text-[17px] text-white mb-2">Feedback that's too clinical</h3>
          <p class="text-[14px] leading-[1.6] text-white/65">Charts and mood scores can't hold a raw feeling. A number doesn't make you feel understood.</p>
        </article>
        <article class="rounded-[14px] border border-white/12 bg-white/[0.04] backdrop-blur-md p-6 shadow-[0_30px_80px_-40px_rgba(0,0,0,0.6),inset_0_1px_0_0_rgba(255,255,255,0.06)]">
          <div class="text-white leading-none text-[44px] mb-4" style="font-family:'Fraunces',serif;letter-spacing:-0.03em">03</div>
          <h3 class="font-sans font-semibold text-[17px] text-white mb-2">Pressure of keeping a record</h3>
          <p class="text-[14px] leading-[1.6] text-white/65">Negative text sitting in a journal you don't want to revisit. Self-censorship creeps in everywhere.</p>
        </article>
      </div>

      <div class="mt-16 pt-10 border-t border-white/15">
        <img src={`${base}img/es_pain_points.png`} alt="Pain points" class="w-full h-auto rounded-[12px] opacity-90" />
      </div>

      <figure class="mt-16 border-l-2 border-white/40 pl-6 md:pl-8">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white/45 mb-3">Design question</div>
        <blockquote class="text-white leading-[1.15] max-w-[38ch]" style="font-family:'Fraunces',serif;font-size:clamp(20px,2.8vw,32px);letter-spacing:-0.02em">
          How might we let someone release an overwhelming feeling with minimal effort —
          <span class="italic text-white/60 block mt-2">and look back later without it feeling heavy?</span>
        </blockquote>
      </figure>
    </section>

    <!-- 2 CONCEPT -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">02</span> — The solution: Shredder + Garden
      </div>
      
      <div class="grid grid-cols-12 gap-8">
        <div class="col-span-12 flex flex-col justify-center">
          <h2 class="text-white leading-[1.1] mb-12" style="font-family:'Fraunces',serif;font-size:clamp(28px,4vw,44px);letter-spacing:-0.03em">
            From emotional release to calm reflection.
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <article class="rounded-[16px] border border-white/15 bg-white/[0.03] p-6 md:p-8">
              <h3 class="font-sans font-semibold text-[18px] text-white mb-3">Shredding = Letting Go</h3>
              <p class="text-[15px] leading-[1.65] text-white/70">"Destroying" raw thoughts on screen provides immediate closure. No negative words kept.</p>
            </article>
            <article class="rounded-[16px] border border-white/15 bg-white/[0.03] p-6 md:p-8">
              <h3 class="font-sans font-semibold text-[18px] text-white mb-3">AI Analysis = Gentle Reframing</h3>
              <p class="text-[15px] leading-[1.65] text-white/70">AI acts as a listener, not a diagnostician. It translates venting into an emotional keyword matched with a flower.</p>
            </article>
            <article class="rounded-[16px] border border-white/15 bg-white/[0.03] p-6 md:p-8">
              <h3 class="font-sans font-semibold text-[18px] text-white mb-3">Garden = Beautiful Archive</h3>
              <p class="text-[15px] leading-[1.65] text-white/70">Past struggles become a peaceful landscape. Rewards emotional release without forcing users to re-read misery.</p>
            </article>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 SCREENS -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">03</span> — Key screens
      </div>
      <h2 class="text-white leading-[0.95] max-w-[20ch] mb-14" style="font-family:'Fraunces',serif;font-size:clamp(32px,5vw,56px);letter-spacing:-0.03em">
        10 screens,<br />
        <span class="italic text-white/60"> one seamless experience.</span>
      </h2>

      <div class="space-y-16 mt-12">
        {screens.map((s, idx) => (
          <article id={s.id} class={`grid grid-cols-12 gap-8 items-center ${idx % 2 !== 0 ? 'md:grid-flow-col-dense' : ''}`}>
            <div class={`col-span-12 md:col-span-5 ${idx % 2 !== 0 ? 'md:col-start-8' : ''}`}>
              <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white/55 mb-2">{s.no}</div>
              <h3 class="font-sans font-semibold text-[22px] leading-[1.2] text-white mb-3">{s.title}</h3>
              <p class="text-[14.5px] leading-[1.7] text-white/65">{s.desc}</p>
            </div>
            <div class={`col-span-12 md:col-span-7 ${idx % 2 !== 0 ? 'md:col-start-1' : ''}`}>
              <figure class="rounded-[14px] border border-white/12 overflow-hidden bg-white/[0.03] max-w-[320px] mx-auto">
                <div class="p-4 md:p-5">
                  {s.mediaType === 'video' ? (
                    <video src={s.media} autoplay muted loop playsinline class="w-full h-auto block rounded-[8px]" />
                  ) : (
                    <img src={s.media} alt={s.alt} class="w-full h-auto block rounded-[8px]" loading="lazy" />
                  )}
                </div>
              </figure>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- 4 KEY DECISIONS -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">04</span> — Design decisions
      </div>
      <h2 class="text-white leading-[0.95] max-w-[22ch] mb-12" style="font-family:'Fraunces',serif;font-size:clamp(32px,5vw,56px);letter-spacing:-0.03em">
        Four key<br />
        <span class="italic text-white/60"> unconventional design decisions.</span>
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {designDecisions.map((d) => (
          <article class="rounded-[14px] border border-white/12 bg-white/[0.04] backdrop-blur-md p-6 shadow-[0_20px_60px_-30px_rgba(0,0,0,0.5),inset_0_1px_0_0_rgba(255,255,255,0.05)]">
            <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white/55 mb-3">{d.no}</div>
            <h3 class="font-sans font-semibold text-[17px] text-white mb-2">{d.title}</h3>
            <p class="text-[14px] leading-[1.65] text-white/65">{d.body}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- 5 REFLECTION -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">05</span> — Learnings & Next Steps
      </div>
      <div class="grid grid-cols-12 gap-8">
        <div class="col-span-12 md:col-span-8 space-y-8">
          <div>
            <h3 class="font-sans font-semibold text-[19px] text-white mb-2">From design to product</h3>
            <p class="text-[15px] leading-[1.65] text-white/70 max-w-[58ch]">
              Building this end-to-end—wiring an AI emotion API, Supabase, and frontend into a working PWA—taught me the fundamental gap between "designing an interface" and "shipping a product".
            </p>
          </div>
          <div>
            <h3 class="font-sans font-semibold text-[19px] text-white mb-2">Real-world validation</h3>
            <p class="text-[15px] leading-[1.65] text-white/70 max-w-[58ch]">
              The current loop proves the concept, but the next step is validation. I plan to test with users to see if delayed reveals actually reduce self-censorship, and if the flower metaphor naturally encourages expression. Their answers will decide if this is just a beautiful prototype, or a viable product direction.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER NAV -->
    <footer class="mt-24 md:mt-32 pt-6 border-t border-white/15 font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/55">
      <div class="flex items-center justify-between">
        <a href={base} class="text-white/70 hover:text-white transition-colors">← Back to home</a>
        <a href={`${base}linepay`} class="text-white/70 hover:text-white transition-colors">01 LinePay Redesign →</a>
      </div>
    </footer>

  </main>
</BaseCaseStudy>
