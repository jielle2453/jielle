---
import BaseCaseStudy from '../../layouts/BaseCaseStudy.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';


const base = import.meta.env.BASE_URL;

const roleItems = [
  { title: '研究統整', body: '梳理 6 大痛點，並彙整出支撐專案方向的「真實 ADHD 聲音」。' },
  { title: 'UI 設計', body: 'Wireframe、資料架構，以及各頁面微調。' },
  { title: '策略討論', body: '參與制定「為 ADHD 女性優化，為所有人設計」的產品定位。' },
];

const pains = [
  { t: '工作記憶弱', d: '計畫與步驟只要一停止回想，就會瞬間從腦海中消失。' },
  { t: '性別表現差異', d: '女性症狀常表現為注意力不集中而非過動，因此容易被忽視。' },
  { t: '被誤解', d: '執行功能障礙常被誤認為是懶惰，從而侵蝕自信心。' },
  { t: '時間盲點', d: '無法準確感知一項任務需要花費多少時間。' },
  { t: '日常健忘', d: '長期與忘記任務、物品和約會抗爭。' },
  { t: '規劃倦怠', d: '光是為了組織思緒就耗盡了所有的心力。' },
];

const voices = [
  '"我很安靜，看起來也很冷靜，但我的腦袋一直在轉——就像同時開了太多瀏覽器分頁。"',
  '"我一直以為自己只是懶惰、沒有紀律。在犯了多年的錯甚至被解僱後，我才意識到我的注意力從未真正上線。"',
  '"這描述完全符合我，但我還是怕自己只是想太多，根本沒有 ADHD。"',
  '"我知道我該做什麼，但我找不到開始的鑰匙。焦慮不斷累積，但我的身體就是無法動彈。"',
];

const values = [
  {
    t: '認知無障礙',
    d: '高對比、清晰色碼。即時視覺提示優於極簡介面。',
  },
  {
    t: '正向增強',
    d: '沒有連續打卡。成就里程碑，不是監控。',
  },
  {
    t: '易讀性',
    d: '更大、更圓潤的字體，減少注意力疲乏時的視覺負擔。',
  },
];
---

<BaseCaseStudy title="Fidgi Grow — Jielle Lu">
  <main class="relative z-10 mx-auto max-w-[1200px] min-h-screen px-6 md:px-12 lg:px-16 pt-8 md:pt-10 pb-24">

    <!-- TOP CHROME -->
    <header class="flex items-start justify-between gap-6 font-mono text-[10.5px] uppercase tracking-[0.2em]">
      <a href={`${base}zh/`} class="inline-flex items-center gap-1.5 text-white/70 hover:text-white transition-colors">
        <span>←</span> 首頁
      </a>
      <div class="text-right space-y-0.5 text-white/55">
        <div class="text-white/80">02-Fidgi Grow</div>
        <div>Portfolio of Jielle Lu</div>
        <LanguageSwitcher class="mt-4 justify-end" />
      </div>
    </header>

    <!-- HERO -->
    <section class="mt-16 md:mt-24 grid grid-cols-12 gap-6 md:gap-10">
      <div class="col-span-12 md:col-span-8">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white/55 mb-4 flex items-center gap-2">
          <span class="text-white text-base leading-none">◆</span>
          <span>第二章 — Fidgi Grow</span>
        </div>

        <h1 class="font-sans font-black tracking-[-0.055em] leading-[0.88] text-white text-[clamp(64px,11vw,176px)]">
          <span class="block">Fidgi</span>
          <span
            class="block font-light italic text-white/60 tracking-[-0.025em]"
            style="font-family: 'Fraunces', serif; font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;"
          >
            Grow.
          </span>
        </h1>

        <p class="mt-10 max-w-[52ch] text-[17px] leading-[1.55] text-white/80">
          一款絕口不提 ADHD 的
          <span class="italic text-white" style="font-family:'Fraunces',serif">ADHD 輔助應用，專為 ADHD 女性設計。</span>
        </p>
      </div>

      <aside class="col-span-12 md:col-span-4 md:pt-16 flex justify-start md:justify-center">
        <div class="flex flex-col items-center md:-ml-8">
          <figure class="rounded-[12px] overflow-hidden border border-white/10 w-full max-w-[240px] mb-5 mt-8 md:mt-0">
            <img src={`${base}img/fidgi_grow_background.png`} alt="Fidgi Grow preview" class="w-full h-auto block" />
          </figure>
          <a
            href="https://www.figma.com/proto/lMFiihwsdyM07jfMH6S59d/ADHD?node-id=0-468&p=f&viewport=275%2C25%2C0.19&t=MRcXL2vjFYe4No7X-1&scaling=min-zoom&content-scaling=fixed&starting-point-node-id=0%3A1651&page-id=0%3A1"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-mono text-[10.5px] uppercase tracking-[0.2em] text-[#38BDF8] hover:text-white transition-colors"
          >
            <span>↗</span>
            <span>Figma prototype</span>
          </a>
        </div>
      </aside>
    </section>

    <!-- META + MY ROLE -->
    <section class="mt-20 md:mt-28 grid grid-cols-12 gap-10">
      <div class="col-span-12 md:col-span-4">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-b border-white/15 pb-3 mb-5">
          <span class="text-white/80"></span> 專案資訊
        </div>
        <dl class="space-y-3 text-[14.5px] leading-[1.55] text-white/75">
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">Time</dt><dd>2025</dd></div>
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">Type</dt><dd>5 人團隊</dd></div>
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">Tools</dt><dd>Figma</dd></div>
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">Tags</dt><dd class="text-white/55">行動端 · 健康照護 · ADHD · 共融設計 · 軟硬體整合</dd></div>
        </dl>
      </div>

      <div class="col-span-12 md:col-span-8">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-b border-white/15 pb-3 mb-5">
          <span class="text-white/80"></span> 我的角色
        </div>
        <ul class="space-y-4">
          {roleItems.map((r) => (
            <li class="grid grid-cols-[160px_1fr] gap-4">
              <span class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-white/80 pt-[2px]">{r.title}</span>
              <span class="text-[14.5px] leading-[1.6] text-white/70">{r.body}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-[14px] leading-[1.55] text-white/55 max-w-[62ch]">
          團隊共同完成：研究 ADHD 女性議題與核心概念發想。
        </p>
      </div>

    </section>

    <!-- THE QUESTION & RESEARCH -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">01</span> — 研究發現
      </div>
      <h2 class="text-white leading-[0.95]" style="font-family:'Fraunces',serif;font-size:clamp(32px,5vw,56px);letter-spacing:-0.03em">
        市面上的 ADHD 應用，<br /><span class="italic text-white/60">幾乎未曾為女性量身打造。</span>
      </h2>

      <!-- 1 RESEARCH -->
      <div class="mt-10 grid grid-cols-1 md:grid-cols-12 gap-8 items-center mb-16">
        <div class="md:col-span-7">
          <p class="text-[15px] leading-[1.65] text-white/80 max-w-[60ch]">
            現有工具都忽略了 <strong class="text-white">賀爾蒙波動</strong> 與 <strong class="text-white">內化的症狀</strong>——而這正是女性 ADHD 最顯著的特徵。女性並非較少患有 ADHD，而是較少被診斷出來。內化的症狀往往被解讀為「個性」或「賀爾蒙影響」，而非神經多樣性。
          </p>
        </div>
        <div class="md:col-span-5 flex justify-center md:justify-end">
          <figure class="w-full max-w-[260px]">
            <img src={`${base}img/fidgi_grow_women.png`} alt="Women with ADHD illustration" class="w-full h-auto object-contain" />
          </figure>
        </div>
      </div>



      <!-- Six pain points -->
      <div class="mt-16">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 mb-4">六大痛點 · 每個對應到一個核心功能</div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {pains.map((p, i) => (
            <article class="rounded-[10px] border border-white/12 bg-white/[0.03] p-5">
              <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-2">0{i + 1}</div>
              <h4 class="font-sans font-semibold text-[16px] text-white">{p.t}</h4>
              <p class="mt-2 text-[13.5px] leading-[1.55] text-white/60">{p.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>


    <!-- 2 STRATEGY -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">02</span> — 策略決策
      </div>

      <figure class="my-6 border-l-2 border-white/40 pl-6 md:pl-10">
        <blockquote class="text-white leading-[1.0] max-w-[18ch]" style="font-family:'Fraunces',serif;font-size:clamp(40px,6.5vw,72px);letter-spacing:-0.03em">
          為 ADHD 女性優化。
          <span class="italic block text-white/60">為所有人設計。</span>
        </blockquote>
      </figure>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
        <article class="rounded-[14px] border border-white/12 bg-white/[0.04] p-6 md:p-7">
          <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-3">同理心</div>
          <p class="text-[14.5px] leading-[1.65] text-white/80">
            懷疑自己只是「做不好事情」的人，不會去搜尋 ADHD APP。
          </p>
        </article>
        <article class="rounded-[14px] border border-white/12 bg-white/[0.04] p-6 md:p-7">
          <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-3">策略</div>
          <p class="text-[14.5px] leading-[1.65] text-white/80">
            ADHD 標籤只服務已確診者；ADHD 友善設計服務所有人。
          </p>
        </article>
      </div>

    </section>


    <!-- 3 THREE DESIGN DECISIONS -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">03</span> — 落實策略的三個設計決策
      </div>

      <!-- 3.1 -->
      <article class="grid grid-cols-12 gap-6 md:gap-8 mb-20">
        <div class="col-span-12 md:col-span-4 flex flex-col gap-5">
          <div>
            <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-2">3.1</div>
            <h3 class="font-sans font-semibold text-[22px] leading-[1.2] text-white">性別友善的註冊流程</h3>
          </div>
          <p class="text-[15px] leading-[1.65] text-white/85">
            四個性別選項、選擇性的週期記錄、可跳過。每個欄位都是刻意的設計決策。
          </p>

        </div>
        <div class="col-span-12 md:col-span-8">
          <figure class="rounded-[16px] border border-white/12 overflow-hidden">
            <div class="bg-white p-4 md:p-6">
              <img
                src={`${base}img/registration.png`}
                alt="性別友善的註冊流程 — 三個畫面"
                class="w-full h-auto rounded-[8px] shadow-[0_2px_16px_rgba(0,0,0,0.10)]"
                loading="lazy"
              />
            </div>
            <div class="px-5 py-2.5 bg-white/[0.04] border-t border-white/10 font-mono text-[9.5px] uppercase tracking-[0.22em] text-white/40">
              Fig 3.1 — 註冊 · 生理性別欄位與選擇性生理期紀錄
            </div>
          </figure>
        </div>
      </article>

      <!-- 3.2 -->
      <article class="grid grid-cols-12 gap-6 md:gap-8 mb-20">
        <div class="col-span-12 md:col-span-4 flex flex-col gap-5">
          <div>
            <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-2">3.2</div>
            <h3 class="font-sans font-semibold text-[22px] leading-[1.2] text-white">考量賀爾蒙的日曆</h3>
          </div>
          <p class="text-[15px] leading-[1.65] text-white/85">
            賀爾蒙週期就放在任務旁邊。進入黃體期時，日曆會浮現：
          </p>
          <blockquote class="text-white/90 border-l-2 border-white/40 pl-5" style="font-family:'Fraunces',serif;font-style:italic;font-size:clamp(18px,2vw,22px);line-height:1.4;letter-spacing:-0.01em">
            "你可能會比平常更容易情緒化。請對自己溫柔一點。"
          </blockquote>
          <ul class="space-y-3 text-[14px] leading-[1.6] text-white/70 mt-6">
            <li class="flex gap-3"><span class="text-white/60 font-mono mt-[2px]">→</span><span><strong class="text-white">資訊 vs. 說教</strong> — 提供數據讓你決定，而不是命令你該做什麼。</span></li>
          </ul>
        </div>
        <div class="col-span-12 md:col-span-8">
          <figure class="rounded-[16px] border border-white/12 overflow-hidden">
            <div class="bg-white p-4 md:p-6">
              <img
                src={`${base}img/calender.png`}
                alt="顯示任務與賀爾蒙週期的日曆"
                class="w-full h-auto rounded-[8px] shadow-[0_2px_16px_rgba(0,0,0,0.10)]"
                loading="lazy"
              />
            </div>
            <div class="px-5 py-2.5 bg-white/[0.04] border-t border-white/10 font-mono text-[9.5px] uppercase tracking-[0.22em] text-white/40">
              Fig 3.2 — 日曆 · 任務顏色編碼 + 賀爾蒙週期特寫
            </div>
          </figure>
        </div>
      </article>

      <!-- 3.3 -->
      <article class="grid grid-cols-12 gap-6 md:gap-8">
        <div class="col-span-12 md:col-span-4 flex flex-col gap-5">
          <div>
            <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-2">3.3</div>
            <h3 class="font-sans font-semibold text-[22px] leading-[1.2] text-white">舒壓玩具 + 遊戲化追蹤</h3>
          </div>
          <p class="text-[15px] leading-[1.65] text-white/85">
            多數 APP 把把玩物品視為干擾。<strong class="text-white">我們反向操作：讓它成為輸入。</strong>
          </p>
          <div class="space-y-3">
            <div class="rounded-[10px] border border-white/12 bg-white/[0.03] p-5">
              <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-2">硬體</div>
              <p class="text-[13.5px] leading-[1.55] text-white/70">磁吸 NFC 玩具附著在手機背面。完成目標可解鎖新的色彩配置。</p>
            </div>
            <div class="rounded-[10px] border border-white/12 bg-white/[0.03] p-5">
              <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-2">軟體</div>
              <p class="text-[13.5px] leading-[1.55] text-white/70">動作觸發虛擬倉鼠。每週圖表讓注意力習慣可視化。成就里程碑制，沒有斷更壓力。</p>
            </div>
          </div>
        </div>
        <div class="col-span-12 md:col-span-8">
          <figure class="rounded-[16px] border border-white/12 overflow-hidden">
            <div class="flex flex-col">
              <div class="bg-white p-4 md:p-6">
                <div class="font-mono text-[9px] uppercase tracking-[0.22em] text-black/35 mb-3 flex items-center gap-1.5">
                  <span class="size-1.5 rounded-full bg-black/25 inline-block"></span>
                  Hardware
                </div>
                <img
                  src={`${base}img/fidget_toy.png`}
                  alt="實體舒壓玩具"
                  class="w-full h-auto rounded-[8px] shadow-[0_2px_16px_rgba(0,0,0,0.10)]"
                  loading="lazy"
                />
              </div>
              <div class="bg-white p-4 md:p-6 border-t border-black/[0.06]">
                <div class="font-mono text-[9px] uppercase tracking-[0.22em] text-black/60 mb-3 flex items-center gap-1.5">
                  <span class="size-1.5 rounded-full bg-black/55 inline-block"></span>
                  App
                </div>
                <img
                  src={`${base}img/tracking_system.png`}
                  alt="遊戲化追蹤系統"
                  class="w-full h-auto rounded-[8px] shadow-[0_2px_16px_rgba(0,0,0,0.10)]"
                  loading="lazy"
                />
              </div>
            </div>
            <div class="px-5 py-2.5 bg-white/[0.04] border-t border-white/10 font-mono text-[9.5px] uppercase tracking-[0.22em] text-white/40">
              Fig 3.3 — NFC 實體玩具與倉鼠虛擬角色
            </div>
          </figure>
        </div>
      </article>
    </section>


    <!-- 4 OTHER FEATURES -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">04</span> — 其他功能
      </div>

      <div class="space-y-14">
        <!-- 4.1 Manage Task -->
        <article class="grid grid-cols-12 gap-6 md:gap-8">
          <div class="col-span-12 md:col-span-4 flex flex-col gap-5">
            <div>
              <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-2">4.1</div>
              <h3 class="font-sans font-semibold text-[20px] leading-[1.25] text-white">任務管理 — 智能拆解</h3>
            </div>

            <ul class="space-y-3 text-[14px] leading-[1.6] text-white/70">
              <li class="flex gap-3"><span class="text-white/60 font-mono mt-[2px]">→</span><span><strong class="text-white">智能拆解</strong> — 一個任務變成一列小步驟。從「該從哪裡開始」到「先做哪一件」。</span></li>
              <li class="flex gap-3"><span class="text-white/60 font-mono mt-[2px]">→</span><span>進度環追蹤實際時間 vs. 預估——逐漸建立準確的時間感知。</span></li>
            </ul>
          </div>
          <div class="col-span-12 md:col-span-8">
            <figure class="rounded-[16px] border border-white/12 overflow-hidden">
              <div class="bg-white p-4 md:p-6">
                <img
                  src={`${base}img/manage_task.png`}
                  alt="任務管理畫面"
                  class="w-full h-auto rounded-[8px] shadow-[0_2px_16px_rgba(0,0,0,0.10)]"
                  loading="lazy"
                />
              </div>
              <div class="px-5 py-2.5 bg-white/[0.04] border-t border-white/10 font-mono text-[9.5px] uppercase tracking-[0.22em] text-white/40">
                Fig 4.1 — 任務清單 · 專注模式 · 智能拆解
              </div>
            </figure>
          </div>
        </article>

        <!-- 4.2 Widgets -->
        <article class="grid grid-cols-12 gap-6 md:gap-8">
          <div class="col-span-12 md:col-span-4 flex flex-col gap-5">
            <div>
              <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-2">4.2</div>
              <h3 class="font-sans font-semibold text-[20px] leading-[1.25] text-white">自定義桌面小工具</h3>
            </div>
            <p class="text-[15px] leading-[1.65] text-white/85">需要打開才能看到的 APP，就是會被忘記打開的 APP。</p>
            <ul class="space-y-3 text-[14px] leading-[1.6] text-white/70">
              <li class="flex gap-3"><span class="text-white/60 font-mono mt-[2px]">→</span><span>舒壓追蹤、任務追蹤、日曆——各自獨立放置在主畫面或鎖定畫面。</span></li>
            </ul>
          </div>
          <div class="col-span-12 md:col-span-8">
            <figure class="rounded-[16px] border border-white/12 overflow-hidden">
              <div class="bg-white p-4 md:p-6">
                <img
                  src={`${base}img/widget.png`}
                  alt="自定義小工具"
