---
import BaseCaseStudy from '../../layouts/BaseCaseStudy.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';


const base = import.meta.env.BASE_URL;

const pains = [
  { t: '工作記憶弱', d: '計畫與步驟只要一停止回想，就會瞬間從腦海中消失。' },
  { t: '性別表現差異', d: '女性症狀常表現為注意力不集中而非過動，因此容易被忽視。' },
  { t: '被誤解', d: '執行功能障礙常被誤認為是懶惰，從而侵蝕自信心。' },
  { t: '時間盲點', d: '無法準確感知一項任務需要花費多少時間。' },
  { t: '日常健忘', d: '長期與忘記任務、物品和約會抗爭。' },
  { t: '規劃倦怠', d: '光是為了組織思緒就耗盡了所有的心力。' },
];

const voices = [
  '"我很安靜，看起來也很冷靜，但我的腦袋一直在轉——就像同時開了太多瀏覽器分頁。"',
  '"我一直以為自己只是懶惰、沒有紀律。在犯了多年的錯甚至被解僱後，我才意識到我的注意力從未真正上線。"',
  '"這描述完全符合我，但我還是怕自己只是想太多，根本沒有 ADHD。"',
  '"我知道我該做什麼，但我找不到開始的鑰匙。焦慮不斷累積，但我的身體就是無法動彈。"',
];

const values = [
  {
    t: '認知無障礙',
    d: '明亮的色彩、高對比度及清晰的顏色編碼以降低認知負荷。對於 ADHD 或閱讀障礙特質，即時的視覺提示優於極簡介面——這意味著我們必須抵抗將其設計成典型北歐風格健康 APP 的衝動。',
  },
  {
    t: '正向增強',
    d: '沒有會因為漏掉一天就懲罰你的連續打卡機制。遊戲化元素作為溫和的動力，而非監視。設計將鼓勵置於生產力焦慮之上。',
  },
  {
    t: '易讀性',
    d: '更大、更圓潤的字體，以減少注意力疲乏時的視覺負擔，支援有閱讀困難或認知超載的用戶。',
  },
];
---

<BaseCaseStudy title="Fidgi Grow — Jielle Lu">
  <main class="relative z-10 mx-auto max-w-[1200px] min-h-screen px-6 md:px-12 lg:px-16 pt-8 md:pt-10 pb-24">

    <!-- TOP CHROME -->
    <header class="flex items-start justify-between gap-6 font-mono text-[10.5px] uppercase tracking-[0.2em]">
      <a href={`${base}zh/`} class="inline-flex items-center gap-1.5 text-white/70 hover:text-white transition-colors">
        <span>←</span> 首頁
      </a>
      <div class="text-right space-y-0.5 text-white/55">
        <div class="text-white/80">§ 02 — 案例研究</div>
        <div>Vol. I · 2025 · 跨領域設計專案</div>
        <LanguageSwitcher class="mt-4 justify-end" />
      </div>
    </header>

    <!-- HERO -->
    <section class="mt-16 md:mt-24 grid grid-cols-12 gap-6 md:gap-10">
      <div class="col-span-12 md:col-span-8">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white/55 mb-4 flex items-center gap-2">
          <span class="text-white text-base leading-none">◆</span>
          <span>第二章 — Fidgi Grow</span>
        </div>

        <h1 class="font-sans font-black tracking-[-0.055em] leading-[0.88] text-white text-[clamp(64px,11vw,176px)]">
          <span class="block">Fidgi</span>
          <span
            class="block font-light italic text-white/60 tracking-[-0.025em]"
            style="font-family: 'Fraunces', serif; font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;"
          >
            Grow.
          </span>
        </h1>

        <p class="mt-10 max-w-[52ch] text-[17px] leading-[1.55] text-white/80">
          一款絕口不提 ADHD 的
          <span class="italic text-white" style="font-family:'Fraunces',serif">ADHD 輔助應用。</span>
        </p>
      </div>

      <aside class="col-span-12 md:col-span-4 md:pt-16">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white/50 border-b border-white/15 pb-2 mb-5">
          閱讀指南
        </div>
        <ul class="space-y-4 text-[15px] leading-[1.4] text-white/75" style="font-family:'Fraunces',serif;font-style:italic">
          <li class="flex gap-3"><span class="text-white/60">→</span><span>§1 研究如何打破了我們的假設。</span></li>
          <li class="flex gap-3"><span class="text-white/60">→</span><span>§2 支撐整個專案的定位策略。</span></li>
          <li class="flex gap-3"><span class="text-white/60">→</span><span>§3 – §4 核心設計決策與功能。</span></li>
          <li class="flex gap-3"><span class="text-white/60">→</span><span>§5 迭代與反思。</span></li>
        </ul>
        <a
          href="https://www.figma.com/proto/lMFiihwsdyM07jfMH6S59d/ADHD?node-id=0-468&p=f&viewport=275%2C25%2C0.19&t=MRcXL2vjFYe4No7X-1&scaling=min-zoom&content-scaling=fixed&starting-point-node-id=0%3A1651&page-id=0%3A1"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-8 inline-flex items-center gap-2 font-mono text-[10.5px] uppercase tracking-[0.2em] text-[#3B82F6] hover:text-white transition-colors"
        >
          <span>↗</span>
          <span>Figma prototype</span>
        </a>
      </aside>
    </section>

    <!-- META + MY ROLE -->
    <section class="mt-20 md:mt-28 grid grid-cols-12 gap-10">
      <div class="col-span-12 md:col-span-4">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-b border-white/15 pb-3 mb-5">
          <span class="text-white/80">§</span> 專案資訊
        </div>
        <dl class="space-y-3 text-[14.5px] leading-[1.55] text-white/75">
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">年份</dt><dd>2025 · 跨領域設計專案</dd></div>
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">團隊</dt><dd>5人 — UI、研究、文案、工設</dd></div>
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">角色</dt><dd>UI 設計 · 研究與策略</dd></div>
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">工具</dt><dd>Figma</dd></div>
          <div class="flex gap-4"><dt class="font-mono text-[10px] uppercase tracking-[0.2em] text-white/45 w-[88px] shrink-0 pt-[3px]">標籤</dt><dd class="text-white/55">Mobile · Healthcare · ADHD · Inclusive · Hardware × software</dd></div>
        </dl>
      </div>

      <div class="col-span-12 md:col-span-8">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-b border-white/15 pb-3 mb-5">
          <span class="text-white/80">§</span> 我的角色
        </div>
        <ul class="mt-5 space-y-3 text-[15px] leading-[1.55] text-white/85">
          <li class="flex gap-3">
            <span class="text-white/60 font-mono mt-[2px]">·</span>
            <span><strong class="text-white">研究統整</strong> — 梳理 6 大痛點，並彙整出支撐專案方向的「真實 ADHD 聲音」。</span>
          </li>
          <li class="flex gap-3">
            <span class="text-white/60 font-mono mt-[2px]">·</span>
            <span><strong class="text-white">UI 設計</strong> — 包含性別友善的註冊流程、整合賀爾蒙週期的日曆，以及遊戲化的追蹤介面。</span>
          </li>
          <li class="flex gap-3">
            <span class="text-white/60 font-mono mt-[2px]">·</span>
            <span><strong class="text-white">策略討論</strong> — 參與制定「為 ADHD 女性優化，為所有人設計」的產品定位。</span>
          </li>
        </ul>
      </div>

    </section>

    <!-- THE QUESTION -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">§</span> 核心問題
      </div>
      <h2 class="text-white leading-[0.95] max-w-[22ch]" style="font-family:'Fraunces',serif;font-size:clamp(32px,5vw,56px);letter-spacing:-0.03em">
        多數的 ADHD APP <span class="italic text-white/60">都會大剌剌地寫在封面上。</span>
      </h2>
      <p class="mt-8 text-[15.5px] leading-[1.65] text-white/80 max-w-[62ch]">
        Notion for ADHD. Tiimo for ADHD. Inflow for ADHD. 
        我們專案第一週也理所當然地這麼假設——
        <em class="italic text-white" style="font-family:'Fraunces',serif">直到研究結果打破了這個想法。</em>
      </p>
    </section>

    <!-- §1 RESEARCH -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">§ 01</span> — 研究發現
      </div>

      <!-- Competitor landscape -->
      <div class="grid grid-cols-12 gap-8 mb-16">
        <div class="col-span-12 md:col-span-4">
          <h3 class="font-sans font-semibold text-[20px] leading-[1.25] text-white">一個飽和市場中的盲點</h3>
        </div>
        <div class="col-span-12 md:col-span-8">
          <p class="text-[15px] leading-[1.65] text-white/80 max-w-[60ch] mb-6">
            無論是通用生產力工具還是專為神經多樣性設計的 APP，都未能考量到 <strong class="text-white">賀爾蒙波動</strong> 與 <strong class="text-white">內化的症狀</strong> ——而這正是女性 ADHD 最顯著的特徵。
          </p>
          <div class="rounded-[12px] border border-white/12 overflow-hidden text-[13.5px]">
            <table class="w-full">
              <thead class="bg-white/[0.05] font-mono text-[10px] uppercase tracking-[0.2em] text-white/55">
                <tr>
                  <th class="text-left py-3 px-4 font-normal">類別</th>
                  <th class="text-left py-3 px-4 font-normal">優勢</th>
                  <th class="text-left py-3 px-4 font-normal">劣勢</th>
                </tr>
              </thead>
              <tbody>
                <tr class="bg-white/[0.015]">
                  <td class="py-3 px-4 text-white font-medium">大型平台 <span class="text-white/50 font-normal">(Todoist, Notion)</span></td>
                  <td class="py-3 px-4 text-white/70">高自由度、功能強大、用戶群廣</td>
                  <td class="py-3 px-4 text-white/50">對執行功能障礙者來說過於複雜；缺乏 ADHD 專用工具</td>
                </tr>
                <tr>
                  <td class="py-3 px-4 text-white font-medium">神經多樣性工具 <span class="text-white/50 font-normal">(Inflow, Tiimo)</span></td>
                  <td class="py-3 px-4 text-white/70">計時器、日常慣例、衛教</td>
                  <td class="py-3 px-4 text-white/50">昂貴；較少關注注意力不集中的表現</td>
                </tr>
                <tr class="bg-white/[0.015]">
                  <td class="py-3 px-4 text-white font-medium">單一功能 <span class="text-white/50 font-normal">(Forest)</span></td>
                  <td class="py-3 px-4 text-white/70">在單一功能上表現出色</td>
                  <td class="py-3 px-4 text-white/50">迫使用戶在多個應用程式間切換</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Women's ADHD blind spot -->
      <div class="grid grid-cols-12 gap-8">
        <div class="col-span-12 md:col-span-4">
          <h3 class="font-sans font-semibold text-[20px] leading-[1.25] text-white">性別帶來的盲區</h3>
        </div>
        <div class="col-span-12 md:col-span-8">
          <p class="text-[15px] leading-[1.65] text-white/80 max-w-[60ch]">
            在成年後，男女性的診斷比例趨於平衡。女性的症狀通常是內化的（容易分心、癱瘓）而非過動，這讓她們看起來像是有「性格缺陷」而不是 ADHD。
          </p>
          <figure class="mt-6 border-l-2 border-white/35 pl-6">
            <blockquote class="text-white max-w-[30ch]" style="font-family:'Fraunces',serif;font-style:italic;font-size:clamp(18px,2.2vw,24px);line-height:1.35;letter-spacing:-0.02em">
              我們該如何為患有 ADHD 的女性設計出能夠適應其認知與情緒狀態變化的輔助工具？
            </blockquote>
          </figure>
          <!-- IMAGE SLOT: A conceptual image showing the internalized nature of ADHD in women, e.g. a chaotic mind vs calm exterior -->
          <div class="mt-8 rounded-[12px] border border-white/20 bg-white/5 p-8 text-center border-dashed text-white/50">
            [待補圖片：呈現女性 ADHD 症狀內化的一面（外表平靜但內心混亂）]
          </div>
        </div>
      </div>


      <!-- Voices -->
      <div class="mt-16 grid grid-cols-12 gap-8">
        <div class="col-span-12 md:col-span-4">
          <h3 class="font-sans font-semibold text-[20px] leading-[1.25] text-white">改變方向的聲音</h3>
          <p class="mt-3 text-[14px] leading-[1.6] text-white/55 max-w-[32ch]">
            來自中文 ADHD 社群 (Dcard, PTT) 的真實心聲。
          </p>
        </div>
        <div class="col-span-12 md:col-span-8 space-y-5">
          {voices.slice(0,2).map((v) => (
            <blockquote class="border-l-2 border-white/35 pl-5 text-white/85" style="font-family:'Fraunces',serif;font-style:italic;font-size:clamp(16px,1.8vw,20px);line-height:1.5;letter-spacing:-0.01em">
              {v}
            </blockquote>
          ))}
          <p class="mt-6 text-[15px] leading-[1.65] text-white/80 max-w-[60ch]">
            許多女性懷疑自己，接著自我懷疑，最後否定。她們不會下載標有「ADHD」的應用程式。 <strong class="text-white">這徹底改變了我們的產品方向。</strong>
          </p>
        </div>
      </div>


      <!-- Six pain points -->
      <div class="mt-16">
        <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 mb-4">六大痛點 · 每個對應到一個核心功能</div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {pains.map((p, i) => (
            <article class="rounded-[10px] border border-white/12 bg-white/[0.03] p-5">
              <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-2">0{i + 1}</div>
              <h4 class="font-sans font-semibold text-[16px] text-white">{p.t}</h4>
              <p class="mt-2 text-[13.5px] leading-[1.55] text-white/60">{p.d}</p>
            </article>
          ))}
        </div>
      </div>
    </section>


    <!-- §2 STRATEGY -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">§ 02</span> — 策略決策
      </div>

      <figure class="my-6 border-l-2 border-white/40 pl-6 md:pl-10">
        <blockquote class="text-white leading-[1.0] max-w-[18ch]" style="font-family:'Fraunces',serif;font-size:clamp(40px,6.5vw,72px);letter-spacing:-0.03em">
          為 ADHD 女性優化。
          <span class="italic block text-white/60">為所有人設計。</span>
        </blockquote>
      </figure>

      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
        <article class="rounded-[14px] border border-white/12 bg-white/[0.04] p-6 md:p-7">
          <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-3">同理心層面</div>
          <p class="text-[14.5px] leading-[1.65] text-white/80">
            一個懷疑自己只是「做不好事情」的女性不會去搜尋「ADHD APP」。貼上標籤只會激起自我懷疑。
          </p>
        </article>
        <article class="rounded-[14px] border border-white/12 bg-white/[0.04] p-6 md:p-7">
          <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-3">策略層面</div>
          <p class="text-[14.5px] leading-[1.65] text-white/80">
            主打 ADHD 的 APP 只能服務已確診者；而具備 ADHD 友善設計的生產力 APP 則能服務所有人。
          </p>
        </article>
      </div>
      
      <!-- IMAGE SLOT: A diagram or visual representation of the target audience (everyone vs ADHD diagnosed) -->
      <div class="mt-8 rounded-[12px] border border-white/20 bg-white/5 p-8 text-center border-dashed text-white/50">
        [待補圖片：說明「為 ADHD 女性優化，為所有人設計」目標客群的圖解或插畫]
      </div>
    </section>


    <!-- §3 THREE DESIGN DECISIONS -->
    <section class="mt-24 md:mt-32">
      <div class="font-mono text-[10.5px] uppercase tracking-[0.2em] text-white/50 border-t border-white/15 pt-4 mb-6">
        <span class="text-white">§ 03</span> — 落實策略的三個設計決策
      </div>

      <!-- 3.1 -->
      <article class="grid grid-cols-12 gap-6 md:gap-8 mb-20">
        <div class="col-span-12 md:col-span-4">
          <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-2">3.1</div>
          <h3 class="font-sans font-semibold text-[22px] leading-[1.2] text-white">性別友善的註冊流程</h3>
        </div>
        <div class="col-span-12 md:col-span-8 space-y-5">
          <figure class="rounded-[16px] border border-white/12 overflow-hidden">
            <div class="bg-white p-4 md:p-6">
              <img
                src={`${base}img/registration.png`}
                alt="性別友善的註冊流程 — 三個畫面"
                class="w-full h-auto rounded-[8px] shadow-[0_2px_16px_rgba(0,0,0,0.10)]"
                loading="lazy"
              />
            </div>
            <div class="px-5 py-2.5 bg-white/[0.04] border-t border-white/10 font-mono text-[9.5px] uppercase tracking-[0.22em] text-white/40">
              Fig 3.1 — 註冊 · 生理性別欄位與選擇性生理期紀錄
            </div>
          </figure>
          <p class="text-[15px] leading-[1.65] text-white/85 max-w-[62ch]">
            註冊時會詢問性別，並可以選擇性記錄上一次的生理週期，藉此產生客製化的計畫。
          </p>
          <ul class="space-y-3 text-[14.5px] leading-[1.6] text-white/70">
            <li class="flex gap-3"><span class="text-white/60 font-mono mt-[2px]">→</span><span><strong class="text-white">對 ADHD 女性而言</strong>，賀爾蒙波動會明顯影響注意力與情緒調節——忽視這一點是市面上多數生產力 APP 的通病。</span></li>
            <li class="flex gap-3"><span class="text-white/60 font-mono mt-[2px]">→</span><span><strong class="text-white">對跨性別者而言</strong>，四個選項的性別欄位釋放出「我們在設計時有考量到你」的訊號。</span></li>
            <li class="flex gap-3"><span class="text-white/60 font-mono mt-[2px]">→</span><span><strong class="text-white">跳過按鈕是不可或缺的。</strong> 在應用程式贏得信任之前強迫提供隱私，只會把使用者拒於門外。</span></li>
          </ul>
        </div>
      </article>

      <!-- 3.2 -->
      <article class="grid grid-cols-12 gap-6 md:gap-8 mb-20">
        <div class="col-span-12 md:col-span-4">
          <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] text-white mb-2">3.2</div>
          <h3 class="font-sans font-semibold text-[22px] leading-[1.2] text-white">考量賀爾蒙的日曆</h3>
        </div>
        <div class="col-span-12 md:col-span-8 space-y-5">
          <figure class="rounded-[16px] border border-white/12 overflow-hidden">
            <div class="bg-white p-4 md:p-6">
              <img
                src={`${base}img/calender.png`}
                alt="顯示任務與賀爾蒙週期的日曆"
                class="w-full h-auto rounded-[8px] shadow-[0_2px_16px_rgba(0,0,0,0.10)]"
