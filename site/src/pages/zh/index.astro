---
import BaseDark from '../../layouts/BaseDark.astro';
import HomeCaseTile from '../../components/HomeCaseTile.astro';
import Marquee from '../../components/Marquee.astro';
import LiveClock from '../../components/LiveClock.svelte';
import NameCard from '../../components/NameCard.astro';
import WorkStrip from '../../components/WorkStrip.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';

interface Chunk {
  text: string;
  variant: 'bold' | 'italic';
  startDelay: number;
  step: number;
  muted?: boolean;
  accent?: boolean;
}
// Eyebrow: "designer & builder" — small line above the big name
const heroChunks: Chunk[] = [
  { text: 'designer ', variant: 'bold', startDelay: 120, step: 28, muted: true },
  { text: '& ',        variant: 'bold', startDelay: 400, step: 34, accent: true },
  { text: 'builder',   variant: 'bold', startDelay: 480, step: 28, muted: true },
];
// Big name: "Jielle Lu" — the hero anchor
const nameLetters = 'Jielle Lu';
const nameStart = 700;
const nameStep = 55;

const toolGroups = [
  { label: 'Research', items: ['User Interviews', 'Surveys', 'Usability Testing', 'SUS', 'SPSS'] },
  { label: 'Design', items: ['Figma', 'Prototyping', 'Personas', 'Journey Maps', 'Info Architecture'] },
  { label: 'Build', items: ['Python', 'TypeScript', 'React', 'FastAPI', 'Claude Code', 'RAG'] },
];

const marqueeItems = [
  '2026 師大資訊學士，尋找全職機會',
  'UX 研究 · 介面設計 · AI 應用開發',
  '台師大 · 曾赴南京大學交換',
  'ASUS UGen AI League 前 20 組',
  'Figma · Python · FastAPI · React',
];
---

<BaseDark title="Jielle Lu — Designer & Builder">
  <main class="relative z-10 min-h-screen flex flex-col px-6 md:px-10 lg:px-14 py-8 md:py-10">

    <!-- TOP CHROME -->
    <header class="fade-up flex items-start justify-between gap-6 font-mono text-[10.5px] uppercase tracking-[0.2em] text-neutral-400" style="animation-delay: 0ms">
      <div class="space-y-0.5 leading-[1.5]">
        <div class="text-white">portfolio of</div>
        <div class="text-neutral-200">jielle lu</div>
        <div class="text-neutral-500">呂筱婕</div>
      </div>
      <div class="text-right space-y-0.5 leading-[1.5]">
        <div class="text-neutral-500 hidden sm:block">jielle2453@gmail.com</div>
        <LanguageSwitcher class="mt-4 justify-end" />
      </div>
    </header>

    <!-- HERO — tagline + h1 bottom-aligned; Currently below fold -->
    <section class="relative flex-1 flex flex-col justify-end pb-2 md:pb-4 pt-12 md:pt-20">

      <h1 class="font-sans font-black tracking-[-0.055em] text-white">
        <!-- eyebrow -->
        <span class="block leading-[2] text-[clamp(14px,1.8vw,22px)]">
          {heroChunks.map((chunk) => (
            <span class:list={[
              chunk.variant === 'italic' ? 'font-light italic text-[#d4a017]' : (chunk.accent ? 'text-[#d4a017]' : chunk.muted ? 'text-[#F3EFE6]/50' : 'text-[#F3EFE6]'),
              'tracking-[-0.01em]',
            ]}
            style={chunk.variant === 'italic'
              ? "font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100,'WONK' 1,'opsz' 144;"
              : undefined}
            >
              {chunk.text.split('').map((ch, i) => (
                <span class="letter" style={`animation-delay: ${chunk.startDelay + i * chunk.step}ms`}>{ch === ' ' ? ' ' : ch}</span>
              ))}
            </span>
          ))}
        </span>
        <!-- big name -->
        <span class="block leading-[0.86] text-[clamp(80px,14vw,210px)]">
          {nameLetters.split('').map((ch, i) => (
            <span class="letter" style={`animation-delay: ${nameStart + i * nameStep}ms`}>{ch === ' ' ? ' ' : ch}</span>
          ))}
        </span>
      </h1>

      <div class="fade-up mt-6 md:mt-8 font-sans text-[clamp(17px,1.7vw,24px)] leading-[1.5] tracking-[0.02em] text-[#F3EFE6]/80 flex items-center gap-3" style="animation-delay: 1200ms">
        <span class="text-[#d4a017] text-[0.7em] leading-none">◆</span>
        <span>從使用者研究出發，設計介面，也把它做出來。</span>
      </div>

    </section>

    <!-- MARQUEE — between hero and work -->
    <div class="fade-up mt-10 md:mt-14 mb-2 md:mb-4" style="animation-delay: 1500ms">
      <Marquee items={marqueeItems} durationSec={58} />
    </div>

    <!-- WORK — six tiles, then two long strips -->
    <section id="work" class="mt-10 md:mt-14">
      <div class="reveal flex items-end justify-between mb-6 font-mono text-[10.5px] uppercase tracking-[0.2em] text-[#F3EFE6]/60" data-reveal>
        <span><span class="text-[#F3EFE6]">作品</span> — 設計與工程</span>
      </div>

      <div class="grid grid-cols-12 gap-4 md:gap-5 items-stretch">
        <div class="col-span-12 md:col-span-4 flex flex-col">
          <HomeCaseTile
            no="01"
            year="2024"
            title="LinePay APP 改版"
            subtitle="重新設計付款流程，打開 APP 就能付款。"
            cta={['看案例', '看案例']}
            href={`${import.meta.env.BASE_URL}zh/linepay`}
            revealDelay={0}
            accent="#06C755"
            previewImg={`${import.meta.env.BASE_URL}img/line_pay_background.png`}
          />
        </div>
        <div class="col-span-12 md:col-span-4 flex flex-col">
          <HomeCaseTile
            no="02"
            year="2025"
            title="Fidgi Grow"
            subtitle="絕口不提 ADHD，卻處處為 ADHD 女性著想的日常 APP。"
            cta={['看案例', '看案例']}
            href={`${import.meta.env.BASE_URL}zh/fidgi`}
            revealDelay={110}
            accent="#38BDF8"
            previewImg={`${import.meta.env.BASE_URL}img/fidgi_grow_background.png`}
          />
        </div>
        <div class="col-span-12 md:col-span-4 flex flex-col">
          <HomeCaseTile
            no="03"
            year="2026—"
            title="Emotion Shredder"
            subtitle="寫下煩惱、粉碎它，看它長成一朵花。"
            cta={['看案例', '看案例']}
            href={`${import.meta.env.BASE_URL}zh/emotion-shredder`}
            revealDelay={220}
            accent="#FBBFCA"
            previewImg={`${import.meta.env.BASE_URL}img/es_cover.png`}
          />
        </div>

        <div class="col-span-12 md:col-span-4 flex flex-col">
          <HomeCaseTile
            no="04"
            year="2026"
            title="Whyscope 好奇鏡"
            subtitle="不連雲端，回答孩子的「為什麼」。"
            cta={['看案例', '看案例']}
            href={`${import.meta.env.BASE_URL}zh/whyscope`}
            revealDelay={0}
            accent="#d4a017"
          />
        </div>
        <div class="col-span-12 md:col-span-4 flex flex-col">
          <HomeCaseTile
            no="05"
            year="2026"
            title="Chitchat Tour"
            subtitle="講解街頭日常事物的 AI 導覽。"
            cta={['看案例', '看案例']}
            href={`${import.meta.env.BASE_URL}zh/chitchat-tour`}
            revealDelay={110}
            accent="#86EFAC"
          />
        </div>
        <div class="col-span-12 md:col-span-4 flex flex-col">
          <HomeCaseTile
            no="06"
            year="2026"
            title="Viral Town"
            subtitle="說一句悄悄話，看 AI 推演整座小鎮的反應。"
            cta={['看案例', '看案例']}
            href={`${import.meta.env.BASE_URL}zh/viral-town`}
            revealDelay={220}
            accent="#C4B5FD"
          />
        </div>
      </div>

      <!-- long strips -->
      <div class="mt-4 md:mt-5 flex flex-col gap-4 md:gap-5">
        <WorkStrip
          label="工程 · 2026"
          title="wiki-with-willy"
          summary="把多年累積的資料夾，變成會回答問題、附出處的知識庫。"
          cta="GitHub"
          href="https://github.com/jielle2453/wiki-dev"
          accent="#7DD3FC"
        />
        <WorkStrip
          label="研究 · 2025"
          title="PTT 股版情緒 × 台股加權指數"
          summary="用 BERT 分析關稅衝擊期間的股版情緒與台股走勢。三人團隊，負責研究規劃與統整。"
          cta="GitHub"
          href="https://github.com/theroyatlas/ptt-sentiment-stock-analysis"
          accent="#F3EFE6"
          revealDelay={80}
        />
      </div>
    </section>

    <!-- ABOUT + CONTACT -->
    <section id="about" class="mt-16 md:mt-24">
      <div class="reveal flex items-end justify-between mb-8 font-mono text-[10.5px] uppercase tracking-[0.2em] text-[#F3EFE6]/60" data-reveal>
        <span><span class="text-[#F3EFE6]">關於</span> — jielle lu</span>
      </div>

      <!-- display tagline -->
      <div class="reveal mb-10 md:mb-14 flex justify-center" data-reveal style="--reveal-delay: 40ms">
        <p class="text-[#F3EFE6]/90 leading-[1.05] max-w-[20ch] text-center"
           style="font-family:'Fraunces',serif;font-variation-settings:'SOFT' 100,'opsz' 144;font-size:clamp(28px,4vw,52px);letter-spacing:-0.025em;font-style:italic;">
          先理解人，再<span style="color:#d4a017">設計</span>，<br/>
          再把它做出來。
        </p>
      </div>

      <!-- bio + quick facts -->
      <div class="reveal flex flex-col items-center text-center mb-10 max-w-[680px] mx-auto" data-reveal style="--reveal-delay: 100ms">
        <p class="font-sans text-[15px] leading-[1.68] text-[#ffffff] mb-8 text-left md:text-center">
          我主修學習科學，習慣從使用者研究切入：先訪談、做易用性測試，再用數據決定設計方向。除了在 Figma 完成介面，我也會寫程式把設計做成真正能用的產品，近期專注在 LLM Agent 與 RAG 應用。我也常用生成式 AI 加速發想與原型製作，讓設計更早被驗證。
        </p>
        
        <!-- Resume Download Button -->
        <a 
          href="https://drive.google.com/file/d/1RgrTpxNRw8DVhHtMWPkOCJnkcu2AuqgL/view?usp=sharing"
          target="_blank"
          rel="noopener noreferrer"
          class="resume-button group inline-flex items-center gap-2.5 px-6 py-3 mb-8 font-mono text-[11px] uppercase tracking-[0.2em] text-[#F3EFE6] border border-[#d4a017]/40 rounded-full hover:border-[#d4a017] hover:bg-[#d4a017]/10 transition-all duration-300"
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 10v2.667A1.333 1.333 0 0 1 12.667 14H3.333A1.333 1.333 0 0 1 2 12.667V10"/>
            <path d="M4.667 6.667L8 10l3.333-3.333"/>
            <path d="M8 10V2"/>
          </svg>
          <span>下載個人簡歷</span>
        </a>
        
        <div class="flex flex-col md:flex-row gap-8 w-full">
          <div class="flex-1">
            <div class="font-mono text-[9px] uppercase tracking-[0.28em] text-[#F3EFE6]/40 mb-1.5">目前狀態</div>
            <div class="font-sans text-[13.5px] leading-[1.5] text-[#F3EFE6]/85">尋找全職機會<br/><span class="text-[#F3EFE6]/55">2026 師大畢業</span></div>
          </div>
          <div class="flex-1">
            <div class="font-mono text-[9px] uppercase tracking-[0.28em] text-[#F3EFE6]/40 mb-1.5">教育背景</div>
            <div class="font-sans text-[13.5px] leading-[1.5] text-[#F3EFE6]/85">台師大 資訊學士 '26<br/><span class="text-[#F3EFE6]/55">南京大學交換生</span></div>
          </div>
          <div class="flex-1">
            <div class="font-mono text-[9px] uppercase tracking-[0.28em] text-[#F3EFE6]/40 mb-1.5">經歷</div>
            <div class="font-sans text-[13.5px] leading-[1.5] text-[#F3EFE6]/85">UIUX 實習生 · PictureCook<br/><span class="text-[#F3EFE6]/55">2025.08 — 2026.02</span></div>
          </div>
        </div>
      </div>

      <!-- tools strip -->
      <div class="reveal flex flex-col items-center mb-10 max-w-[680px] mx-auto" data-reveal style="--reveal-delay: 160ms">
        <div class="font-mono text-[9.5px] uppercase tracking-[0.26em] text-[#F3EFE6]/40 mb-3">Tools &amp; methods</div>
        <div class="flex flex-col items-center gap-2">
          {toolGroups.map((g) => (
            <div class="flex flex-wrap gap-2 justify-center" aria-label={g.label}>
              {g.items.map((t) => (
                <span class="inline-block px-3 py-1 rounded-full border border-[#F3EFE6]/10 font-mono text-[9.5px] uppercase tracking-[0.16em] text-[#F3EFE6]/50 hover:border-[#d4a017] hover:text-[#d4a017] transition-colors">
                  {t}
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>

      <!-- NameCard -->
      <div class="flex justify-center max-w-[1200px] mx-auto">
        <NameCard revealDelay={220} centered />
      </div>
    </section>


  </main>

  <!-- Custom cursor ring -->
  <div id="cursor-ring" aria-hidden="true"></div>

  <!-- Scroll reveal observer -->
  <script is:inline>
    (() => {
      if (typeof window === 'undefined') return;
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('[data-reveal]');
      if (prefersReduced) {
        els.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
      els.forEach((el) => io.observe(el));
    })();
  </script>

  <!-- Cursor + magnetic tile interactions -->
  <script is:inline>
    (() => {
      if (typeof window === 'undefined') return;
      // only on pointer-fine devices (mouse, not touchscreen)
      if (!window.matchMedia('(pointer: fine)').matches) return;

      // ── Custom cursor ring ──────────────────────────────────────────
      const ring = document.getElementById('cursor-ring');
      document.documentElement.classList.add('has-custom-cursor');

      let visible = false;
      const move = (e) => {
        ring.style.left = e.clientX + 'px';
        ring.style.top  = e.clientY + 'px';
        if (!visible) { ring.classList.add('is-visible'); visible = true; }
      };
      document.addEventListener('mousemove', move, { passive: true });
      document.addEventListener('mouseleave', () => {
        ring.classList.remove('is-visible');
        visible = false;
      });

      // enlarge ring on interactive elements
      document.querySelectorAll('a, button').forEach((el) => {
        el.addEventListener('mouseenter', () => ring.classList.add('is-hover'));
        el.addEventListener('mouseleave', () => ring.classList.remove('is-hover'));
      });

      // ── Magnetic 3-D tilt on case tiles ────────────────────────────
      document.querySelectorAll('.case-tile').forEach((tile) => {
        tile.addEventListener('mouseenter', () => {
          // disable the transform portion of the CSS transition while the
          // mouse is inside so each frame updates instantly (no smearing)
          tile.style.transitionProperty = 'border-color, background-color, box-shadow';
          ring.classList.add('is-hover');
        });

        tile.addEventListener('mousemove', (e) => {
          const r = tile.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width  - 0.5;  // -0.5…0.5
          const y = (e.clientY - r.top)  / r.height - 0.5;
          tile.style.transform =
            `perspective(900px) rotateY(${x * 9}deg) rotateX(${-y * 6}deg) translateY(-5px)`;
        });

        tile.addEventListener('mouseleave', () => {
          // restore transform to the CSS transition so the return is smooth
          tile.style.transitionProperty = '';
          tile.style.transform = '';
          ring.classList.remove('is-hover');
        });
      });
    })();
  </script>

  <style is:global>
    /* hide system cursor on pointer-fine devices when custom cursor is active */
    html.has-custom-cursor,
    html.has-custom-cursor * { cursor: none !important; }

    #cursor-ring {
      position: fixed;
      top: 0; left: 0;
      width: 26px; height: 26px;
      border: 1px solid rgba(255,255,255,0.30);
      border-radius: 50%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      z-index: 9999;
      opacity: 0;
      transition:
        width  0.28s cubic-bezier(0.22,1,0.36,1),
        height 0.28s cubic-bezier(0.22,1,0.36,1),
        border-color 0.28s,
        opacity 0.35s;
    }
    #cursor-ring.is-visible { opacity: 1; }
    #cursor-ring.is-hover {
      width: 50px; height: 50px;
      border-color: rgba(255,255,255,0.55);
    }


  </style>
</BaseDark>
